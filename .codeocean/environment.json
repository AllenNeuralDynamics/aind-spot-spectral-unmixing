{
	"version": 1,
	"base_image": "codeocean/lightning-jupyterlab-py39:1.0",
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"pip": {
			"packages": [
				{
					"name": "boto3",
					"version": "1.40.65"
				},
				{
					"name": "dask",
					"version": "2024.5.2"
				},
				{
					"name": "joblib",
					"version": "1.4.2"
				},
				{
					"name": "matplotlib",
					"version": "3.9.2"
				},
				{
					"name": "numpy",
					"version": "1.26.4"
				},
				{
					"name": "pandas",
					"version": "2.2.3"
				},
				{
					"name": "scipy",
					"version": "1.13.1"
				},
				{
					"name": "seaborn",
					"version": "0.13.2"
				},
				{
					"name": "seaborn-image",
					"version": "0.10.0"
				},
				{
					"name": "tqdm",
					"version": "4.66.5"
				},
				{
					"name": "tqdm-joblib",
					"version": "0.0.4"
				},
				{
					"name": "xmltodict",
					"version": "1.0.2"
				},
				{
					"name": "zarr",
					"version": "2.18.2"
				}
			],
			"options": {},
			"pre_install_options": {}
		},
		"vscode": {
			"packages": [
				{
					"name": "continue.continue"
				},
				{
					"name": "ms-python.python"
				},
				{
					"name": "ms-toolsai.jupyter"
				},
				{
					"name": "reageyao.biosyntax"
				},
				{
					"name": "reditorsupport.r"
				},
				{
					"name": "saoudrizwan.claude-dev"
				}
			],
			"version": "4.100.3"
		}
	}
}